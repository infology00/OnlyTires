<section class="vsection vsection--alt" id="fleet-form">
  <div class="wrap">
    <div class="quote-panel reveal">
      <div class="quote-side">
        <span class="eyebrow" style="color:#8FA6FF">Fleet inquiry</span>
        <h2>Tell Us About Your Fleet</h2>
        <p>Send the basics and we'll follow up by phone with account pricing and a service plan.</p>
        <ul>
          <li>Fleet inquiries are routed separately</li>
          <li>Phone follow-up — talk to a real person</li>
        </ul>
        <div class="tread" aria-hidden="true"></div>
      </div>
      <form class="quote-form" data-quote-form>
        <div class="form-success" role="status">✓ Received! We'll follow up by phone to talk fleet pricing and scheduling.</div>
        <div class="field"><label for="f-company">Company name <b>*</b></label><input id="f-company" type="text" required autocomplete="organization"></div>
        <div class="form-row">
          <div class="field"><label for="f-contact">Contact name <b>*</b></label><input id="f-contact" type="text" required autocomplete="name"></div>
          <div class="field"><label for="f-phone">Phone <b>*</b></label><input id="f-phone" type="tel" required autocomplete="tel"></div>
        </div>
        <div class="field"><label for="f-email">Email</label><input id="f-email" type="email" autocomplete="email"></div>
        <div class="form-row">
          <div class="field"><label for="f-size">Fleet size / vehicle types</label><input id="f-size" type="text" placeholder="e.g. 12 vans, 4 pickups"></div>
          <div class="field">
            <label for="f-need">Service needed</label>
            <select id="f-need">
              <option value="">Select…</option>
              <option>Tire supply &amp; installation</option>
              <option>Scheduled maintenance</option>
              <option>Rotation / balance / alignment</option>
              <option>Repairs</option>
              <option>Full fleet program</option>
            </select>
          </div>
        </div>
        <div class="field"><label for="f-msg">Message</label><textarea id="f-msg" placeholder="Tell us about your operation and timing…"></textarea></div>
        <div class="field field--file">
          <label for="f-photo">Attach a vehicle or fleet list (optional)</label>
          <label class="filedrop" for="f-photo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M17 8l-5-5-5 5"/><path d="M12 3v13"/></svg>
            <span class="filedrop-text">
              <b>Upload a file</b>
              <small>Drag &amp; drop, or tap to browse</small>
            </span>
            <input id="f-photo" name="photo" type="file" accept="image/*,.pdf,.csv,.xlsx">
          </label>
        </div>
        <button class="btn btn--primary btn--lg" type="submit">Send Fleet Inquiry <span class="btn-arrow">→</span></button>
      </form>
    </div>
  </div>
</section>
