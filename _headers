# Netlify / Cloudflare Pages cache rules
# Hashed-by-content assets could be cached forever; these are stable paths,
# so they get a long TTL with revalidation instead.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=604800, must-revalidate

/js/*
  Cache-Control: public, max-age=604800, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate
